{
  "manifest_version": 3,
  "name": "Thistle",
  "version": "1.0.0",
  "description": "Toolkit for Claude — a true-black theme for claude.ai, an inline session-usage gauge, Markdown export, and one-click context transfer to ChatGPT, Gemini or Grok.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Thistle",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thistle@local.extension",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["content/base.css"],
      "js": ["content/apply-theme.js", "content/mark.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "css": ["content/usage.css"],
      "js": [
        "content/bridge-client.js",
        "content/usage.js",
        "content/export.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": ["content/receiver.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/bridge.js"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
